{
  "name": "your-brain-is-lying",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/game/*.test.js",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@supabase/supabase-js": "2.117.3"
  },
  "devDependencies": {
    "vite": "^7.1.7",
    "@vitejs/plugin-react": "^5.0.4"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.ayushyadav.yourbrainislying",
    "productName": "Your Brain Is Lying",
    "electronVersion": "45.0.0",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "README.md"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Your-Brain-Is-Lying-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "Your-Brain-Is-Lying-Portable.${ext}"
    }
  }
}
